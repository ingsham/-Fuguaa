# Copy this file to .env.local and fill in real values.
# See README.md section 1 for where to get each of these.

DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Data-at-rest encryption key for sensitive fields (Ghana Card numbers etc.)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Paystack (Ghana payments: Mobile Money + cards) ---
# Sign up at https://paystack.com, use TEST keys during development
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- Ghana Card / NIA verification ---
# No public self-serve API currently exists — verification is a manual
# admin-review flow for now. Reserved for if/when one becomes available.
NIA_VERIFICATION_API_KEY=""
